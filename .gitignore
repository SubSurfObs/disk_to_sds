# Ignore everything inside inbox/ but keep the folder
inbox/*
!inbox/.gitkeep

# Ignore everything inside local_sds/ but keep the folder
local_sds/*
!local_sds/.gitkeep

# Plan files are ephemeral; durable manifests in manifests/*.jsonl are tracked
manifests/plans/*
!manifests/plans/.gitkeep

# Standard Python / dev-environment ignores
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.DS_Store

# Per-session Claude config (operator-local, not a project artefact)
.claude/
